<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Pokedex</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Custom styles */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6; /* Light gray background */
        }
        /* Style for the modal backdrop */
        .modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            z-index: 40; /* Below modal */
            display: flex; /* Use flexbox for centering */
            justify-content: center; /* Center horizontally */
            align-items: center; /* Center vertically */
        }
        /* Style for the modal content */
        .modal-content {
            position: relative; /* Needed for absolute positioning of close button */
            z-index: 50; /* Above backdrop */
            max-height: 90vh; /* Limit height */
            overflow-y: auto; /* Add scroll if content overflows */
        }
        /* Style for Pokemon type badges */
        .type-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px; /* Full round */
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: capitalize;
            margin: 0.2rem;
            color: white;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }
        /* Type colors (approximations) */
        .type-normal { background-color: #A8A77A; }
        .type-fire { background-color: #EE8130; }
        .type-water { background-color: #6390F0; }
        .type-electric { background-color: #F7D02C; }
        .type-grass { background-color: #7AC74C; }
        .type-ice { background-color: #96D9D6; }
        .type-fighting { background-color: #C22E28; }
        .type-poison { background-color: #A33EA1; }
        .type-ground { background-color: #E2BF65; }
        .type-flying { background-color: #A98FF3; }
        .type-psychic { background-color: #F95587; }
        .type-bug { background-color: #A6B91A; }
        .type-rock { background-color: #B6A136; }
        .type-ghost { background-color: #735797; }
        .type-dragon { background-color: #6F35FC; }
        .type-dark { background-color: #705746; }
        .type-steel { background-color: #B7B7CE; }
        .type-fairy { background-color: #D685AD; }

        /* Simple Stat Bar */
        .stat-bar-bg {
            background-color: #e0e0e0; /* Light gray background for the bar */
            border-radius: 9999px;
            height: 10px;
            overflow: hidden; /* Ensure inner bar stays within bounds */
        }
        .stat-bar {
            height: 100%;
            border-radius: 9999px;
            transition: width 0.5s ease-in-out; /* Smooth transition for width change */
        }
        /* Colors for different stats */
        .stat-hp { background-color: #FF5959; } /* Red */
        .stat-attack { background-color: #F5AC78; } /* Orange */
        .stat-defense { background-color: #FAE078; } /* Yellow */
        .stat-special-attack { background-color: #9DB7F5; } /* Blue */
        .stat-special-defense { background-color: #A7DB8D; } /* Green */
        .stat-speed { background-color: #FA92B2; } /* Pink */

        /* Image pixelated effect */
        .pixelated {
             image-rendering: pixelated;
             image-rendering: -moz-crisp-edges;
             image-rendering: crisp-edges;
        }

        /* Loading spinner */
        .loader {
          border: 4px solid #f3f3f3; /* Light grey */
          border-top: 4px solid #3498db; /* Blue */
          border-radius: 50%;
          width: 40px;
          height: 40px;
          animation: spin 1s linear infinite;
          margin: 20px auto; /* Center the loader */
        }

        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-gray-100 p-4 md:p-8">

    <div class="container mx-auto max-w-6xl">
        <h1 class="text-3xl md:text-4xl font-bold text-center text-red-600 mb-6 md:mb-10">Pokédex</h1>

        <div class="mb-6 md:mb-8">
            <input type="text" id="searchInput" placeholder="Search Pokémon by name..."
                   class="w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition duration-150 ease-in-out">
        </div>

        <div id="loadingIndicator" class="text-center py-10">
            <div class="loader"></div>
            <p class="text-gray-600 mt-2">Loading Pokémon...</p>
        </div>

        <div id="pokedexGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6">
            </div>

        <div id="pokemonModal" class="modal-backdrop hidden" onclick="closeModalOutside(event)">
            <div class="modal-content bg-white rounded-lg shadow-xl w-11/12 max-w-lg p-5 md:p-8 m-4">
                <button onclick="closeModal()" class="absolute top-3 right-3 text-gray-500 hover:text-gray-800 text-2xl font-bold">&times;</button>

                <div id="modalContent" class="text-center">
                    <div class="loader"></div> </div>
            </div>
        </div>

    </div>

    <script>
        const pokedexGrid = document.getElementById('pokedexGrid');
        const searchInput = document.getElementById('searchInput');
        const pokemonModal = document.getElementById('pokemonModal');
        const modalContent = document.getElementById('modalContent');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const POKEMON_COUNT = 50; // Number of Pokémon to fetch
        let allPokemonData = []; // Store all fetched Pokémon data for filtering

        // --- Utility Functions ---

        // Function to format Pokemon ID (e.g., 1 -> #001)
        const formatPokemonId = (id) => `#${String(id).padStart(3, '0')}`;

        // Function to capitalize first letter
        const capitalize = (str) => str.charAt(0).toUpperCase() + str.slice(1);

        // --- API Fetching ---

        // Fetches data for a single Pokémon by ID or name
        const fetchPokemonData = async (id) => {
            try {
                const url = `https://pokeapi.co/api/v2/pokemon/${id}`;
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                return data;
            } catch (error) {
                console.error("Could not fetch Pokémon data:", error);
                return null; // Return null on error
            }
        };

        // Fetches a list of Pokémon (names and URLs)
        const fetchPokemonList = async (limit) => {
            try {
                const url = `https://pokeapi.co/api/v2/pokemon?limit=${limit}&offset=0`;
                const response = await fetch(url);
                 if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                return data.results; // Array of {name, url}
            } catch (error) {
                console.error("Could not fetch Pokémon list:", error);
                return []; // Return empty array on error
            }
        };

        // --- Display Logic ---

        // Creates an HTML card for a single Pokémon
        const createPokemonCard = (pokemon) => {
            const card = document.createElement('div');
            card.className = `pokemon-card bg-white rounded-lg shadow-md p-4 flex flex-col items-center cursor-pointer hover:shadow-lg hover:scale-105 transition-transform duration-200 ease-in-out border border-gray-200`;
            card.dataset.pokemonId = pokemon.id; // Store ID for modal fetching
            card.dataset.pokemonName = pokemon.name; // Store name for searching

            const spriteUrl = pokemon.sprites?.front_default || 'https://placehold.co/96x96/e0e0e0/a0a0a0?text=?'; // Default sprite or placeholder
            const pokemonIdFormatted = formatPokemonId(pokemon.id);

            // Image container to control size
            const imgContainer = document.createElement('div');
            imgContainer.className = 'w-24 h-24 mb-3 flex items-center justify-center bg-gray-100 rounded-full'; // Circular background

            const image = document.createElement('img');
            image.src = spriteUrl;
            image.alt = `Image of ${capitalize(pokemon.name)}`;
            image.className = 'w-20 h-20 object-contain pixelated'; // Pixelated style for retro look
            image.onerror = () => { // Fallback if image fails to load
                image.src = 'https://placehold.co/96x96/e0e0e0/a0a0a0?text=?';
                image.alt = `Placeholder image for ${capitalize(pokemon.name)}`;
            }
            imgContainer.appendChild(image);

            const name = document.createElement('h3');
            name.className = 'text-lg font-semibold text-gray-800 capitalize mb-1 text-center';
            name.textContent = pokemon.name;

            const idText = document.createElement('p');
            idText.className = 'text-sm text-gray-500 mb-2';
            idText.textContent = pokemonIdFormatted;

            const typesContainer = document.createElement('div');
            typesContainer.className = 'flex justify-center flex-wrap';
            pokemon.types.forEach(typeInfo => {
                const typeBadge = document.createElement('span');
                const typeName = typeInfo.type.name;
                typeBadge.className = `type-badge type-${typeName}`;
                typeBadge.textContent = typeName;
                typesContainer.appendChild(typeBadge);
            });

            card.appendChild(imgContainer);
            card.appendChild(name);
            card.appendChild(idText);
            card.appendChild(typesContainer);

            // Add event listener to open modal on click
            card.addEventListener('click', () => openModal(pokemon.id));

            return card;
        };

        // Displays all Pokémon cards in the grid
        const displayPokemon = (pokemonList) => {
            pokedexGrid.innerHTML = ''; // Clear previous cards
            if (pokemonList.length === 0) {
                 pokedexGrid.innerHTML = '<p class="col-span-full text-center text-gray-500">No Pokémon found matching your search.</p>';
            } else {
                pokemonList.forEach(pokemon => {
                    if (pokemon) { // Check if pokemon data is valid
                         const card = createPokemonCard(pokemon);
                         pokedexGrid.appendChild(card);
                    }
                });
            }
        };

        // --- Modal Logic ---

        // Opens the modal and fetches/displays detailed data
        const openModal = async (pokemonId) => {
            pokemonModal.classList.remove('hidden'); // Show the modal backdrop
            modalContent.innerHTML = '<div class="loader"></div><p class="text-gray-600 mt-2">Loading details...</p>'; // Show loader in modal

            const pokemonData = await fetchPokemonData(pokemonId);

            if (!pokemonData) {
                modalContent.innerHTML = '<p class="text-red-500 font-semibold">Could not load Pokémon details. Please try again later.</p>';
                return;
            }

            // Populate modal content
            const spriteUrl = pokemonData.sprites?.other?.['official-artwork']?.front_default || pokemonData.sprites?.front_default || 'https://placehold.co/150x150/e0e0e0/a0a0a0?text=?';
            const pokemonIdFormatted = formatPokemonId(pokemonData.id);

            // Basic Info Section
            let modalHTML = `
                <div class="flex flex-col items-center mb-4">
                     <div class="w-36 h-36 mb-3 flex items-center justify-center bg-gray-100 rounded-full overflow-hidden">
                        <img src="${spriteUrl}" alt="Image of ${capitalize(pokemonData.name)}" class="w-32 h-32 object-contain pixelated" onerror="this.onerror=null; this.src='https://placehold.co/150x150/e0e0e0/a0a0a0?text=?'; this.alt='Placeholder image';">
                    </div>
                    <h2 class="text-3xl font-bold capitalize text-gray-800">${pokemonData.name}</h2>
                    <p class="text-lg text-gray-500 mb-3">${pokemonIdFormatted}</p>
                    <div class="flex justify-center flex-wrap mb-4">
                        ${pokemonData.types.map(typeInfo => `<span class="type-badge type-${typeInfo.type.name}">${typeInfo.type.name}</span>`).join('')}
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 text-left mb-5 px-4">
                    <div><strong class="text-gray-700">Height:</strong> <span class="text-gray-600">${(pokemonData.height / 10).toFixed(1)} m</span></div>
                    <div><strong class="text-gray-700">Weight:</strong> <span class="text-gray-600">${(pokemonData.weight / 10).toFixed(1)} kg</span></div>
                </div>

                 <div class="mb-5 px-4 text-left">
                     <h4 class="text-xl font-semibold mb-2 text-gray-700">Abilities</h4>
                     <ul class="list-disc list-inside text-gray-600">
                        ${pokemonData.abilities.map(abilityInfo => `<li class="capitalize">${abilityInfo.ability.name.replace('-', ' ')}</li>`).join('')}
                     </ul>
                 </div>

                 <div class="px-4 text-left">
                    <h4 class="text-xl font-semibold mb-3 text-gray-700">Base Stats</h4>
            `;

            // Stats Section - Max stat value for percentage calculation (approximation)
            const maxStatValue = 255; // Theoretical max, adjust if needed for better visualization

            pokemonData.stats.forEach(statInfo => {
                const statName = statInfo.stat.name.replace('-', ' ').replace('special ', 'Sp. ');
                const statValue = statInfo.base_stat;
                const statPercentage = Math.min(100, (statValue / maxStatValue) * 100); // Cap at 100%

                // Determine stat bar color class
                let statColorClass = '';
                switch (statInfo.stat.name) {
                    case 'hp': statColorClass = 'stat-hp'; break;
                    case 'attack': statColorClass = 'stat-attack'; break;
                    case 'defense': statColorClass = 'stat-defense'; break;
                    case 'special-attack': statColorClass = 'stat-special-attack'; break;
                    case 'special-defense': statColorClass = 'stat-special-defense'; break;
                    case 'speed': statColorClass = 'stat-speed'; break;
                    default: statColorClass = 'bg-gray-400'; // Default gray
                }

                modalHTML += `
                    <div class="mb-2 grid grid-cols-5 items-center gap-2">
                        <span class="col-span-2 capitalize font-medium text-gray-600 text-sm">${statName}</span>
                        <span class="col-span-1 text-right font-semibold text-gray-700 text-sm">${statValue}</span>
                        <div class="col-span-2 stat-bar-bg">
                             <div class="stat-bar ${statColorClass}" style="width: ${statPercentage}%;"></div>
                        </div>
                    </div>
                `;
            });

             modalHTML += `</div>`; // Close stats container

            modalContent.innerHTML = modalHTML;
        };

        // Closes the modal
        const closeModal = () => {
            pokemonModal.classList.add('hidden');
            modalContent.innerHTML = ''; // Clear content when closing
        };

        // Closes the modal if clicked outside the content area
        const closeModalOutside = (event) => {
            if (event.target === pokemonModal) { // Check if the click was on the backdrop itself
                closeModal();
            }
        };

        // --- Search/Filter Logic ---

        const filterPokemon = () => {
            const searchTerm = searchInput.value.toLowerCase();
            const filteredPokemon = allPokemonData.filter(pokemon =>
                pokemon && pokemon.name.toLowerCase().includes(searchTerm)
            );
            displayPokemon(filteredPokemon);
        };

        // Add event listener for the search input
        searchInput.addEventListener('input', filterPokemon);


        // --- Initialization ---

        // Main function to initialize the Pokedex
        const initializePokedex = async () => {
            loadingIndicator.classList.remove('hidden'); // Show loading spinner
            pokedexGrid.innerHTML = ''; // Clear grid initially

            const pokemonList = await fetchPokemonList(POKEMON_COUNT);

            if (pokemonList.length === 0) {
                 loadingIndicator.innerHTML = '<p class="text-red-500 font-semibold">Failed to load Pokémon list. Please check your connection or try again later.</p>';
                 return;
            }

            // Fetch detailed data for all Pokémon in the list
            // Using Promise.all for parallel fetching
            const pokemonDataPromises = pokemonList.map(p => fetchPokemonData(p.name));
            allPokemonData = await Promise.all(pokemonDataPromises);

            // Filter out any null results from failed fetches before displaying
            allPokemonData = allPokemonData.filter(p => p !== null);

            loadingIndicator.classList.add('hidden'); // Hide loading spinner

            if (allPokemonData.length === 0 && pokemonList.length > 0) {
                 // This case means the list was fetched, but individual data failed
                 pokedexGrid.innerHTML = '<p class="col-span-full text-center text-red-500 font-semibold">Could not load details for any Pokémon. Please try again later.</p>';
            } else if (allPokemonData.length === 0) {
                 // This case means the initial list fetch likely failed (already handled above, but as a fallback)
                 pokedexGrid.innerHTML = '<p class="col-span-full text-center text-gray-500">No Pokémon data available.</p>';
            }
            else {
                displayPokemon(allPokemonData); // Display the fetched Pokémon
            }
        };

        // Start the process when the DOM is loaded
        document.addEventListener('DOMContentLoaded', initializePokedex);

    </script>

</body>
</html>
